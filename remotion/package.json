{
  "name": "remotion",
  "version": "1.0.0",
  "description": "My Remotion video",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.507",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.507",
    "@remotion/tailwind-v4": "4.0.507",
    "tailwindcss": "4.0.0"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.507",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render:analyse": "remotion render AnalysisDemo ../frontend/public/videos/analyse.mp4 --codec=h264 --crf=28",
    "render:entretien": "remotion render InterviewDemo ../frontend/public/videos/entretien.mp4 --codec=h264 --crf=28",
    "render:posters": "remotion still AnalysisDemo ../frontend/public/videos/analyse-poster.webp --frame=360 && remotion still InterviewDemo ../frontend/public/videos/entretien-poster.webp --frame=380",
    "render:landing": "./scripts/render-landing.sh"
  },
  "sideEffects": [
    "*.css"
  ]
}