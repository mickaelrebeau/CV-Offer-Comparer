# Google AI (Gemini)
GOOGLE_API_KEY=your_google_api_key
GEMINI_MODEL=gemini-flash-latest

# Google OAuth (Console Cloud → Identifiants OAuth 2.0)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
FRONTEND_URL=http://localhost:3000

# FastAPI / JWT
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# PostgreSQL Railway
# Local : DATABASE_PUBLIC_URL (TCP proxy)
# Sur Railway : DATABASE_URL (réseau privé)
DATABASE_URL=postgresql://postgres:password@host:port/railway

# Redis Railway
REDIS_URL=redis://default:password@host:port
REDIS_PASSWORD=
REDIS_DB=0

# CORS (CSV)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://cv-compare.up.railway.app

# Rate limiting (0 = illimité) — voir README « Limites d’usage »
RATE_LIMIT_ENABLED=true
RATE_LIMIT_USER_PER_MINUTE=10
RATE_LIMIT_IP_PER_MINUTE=30
DAILY_QUOTA_COMPARE=50
DAILY_QUOTA_INTERVIEW_GENERATE=30
DAILY_QUOTA_INTERVIEW_ANALYZE=30
DAILY_QUOTA_COVER_LETTER=30
DAILY_QUOTA_CV_OPTIMIZER=20
DAILY_QUOTA_APPLICATIONS=100
DAILY_QUOTA_UPLOAD=100
# Header avec l'IP réelle du client (Railway : X-Real-IP). Vide = IP de la socket (pas de proxy)
CLIENT_IP_HEADER=X-Real-IP
# Environnement : "production" sur Railway
ENVIRONMENT=development
# Endpoints de debug (test-stream, reset free-trial, stats) — toujours désactivés si ENVIRONMENT=production
ENABLE_DEBUG_ENDPOINTS=false

# Clés API LLM personnelles (BYOK) — chiffrement Fernet, vide = fonctionnalité désactivée
# Générer : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotation : nouvelle clé en tête (nouvelle,ancienne), puis python -m app.scripts.rotate_llm_keys
LLM_ENCRYPTION_KEYS=
# Dev uniquement : autorise http:// et localhost comme base_url (Ollama…). Ignoré si ENVIRONMENT=production
LLM_ALLOW_PRIVATE_BASE_URLS=false
LLM_REQUEST_TIMEOUT_SECONDS=90
DAILY_QUOTA_LLM_CREDENTIALS=50

# E-mails transactionnels (vérification d'adresse, mot de passe oublié)
# console = liens affichés dans les logs (dev) ; resend = envoi réel (https://resend.com)
EMAIL_PROVIDER=console
RESEND_API_KEY=
# Domaine d'envoi à vérifier dans Resend
EMAIL_FROM=Talento <no-reply@talento.app>
EMAIL_VERIFICATION_TTL_HOURS=48
PASSWORD_RESET_TTL_MINUTES=60
